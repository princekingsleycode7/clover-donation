{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__route=/api/$1" },
    { "source": "/api", "destination": "/api?__route=/api" },
    { "source": "/initiate-donation", "destination": "/api?__route=/initiate-donation" },
    { "source": "/config", "destination": "/api?__route=/config" },
    { "source": "/verify-transaction", "destination": "/api?__route=/verify-transaction" },
    { "source": "/verify-transaction/(.*)", "destination": "/api?__route=/verify-transaction/$1" },
    { "source": "/donation-total", "destination": "/api?__route=/donation-total" },
    { "source": "/transactions/(.*)", "destination": "/api?__route=/transactions/$1" },
    { "source": "/version1", "destination": "/version1.html" },
    { "source": "/v1", "destination": "/version1.html" },
    { "source": "/version2", "destination": "/version2.html" },
    { "source": "/v2", "destination": "/version2.html" },
    { "source": "/amira", "destination": "/amira.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/(.*)", "destination": "/blog.html?post=$1" },
    { "source": "/stories", "destination": "/blog.html" },
    { "source": "/stories/(.*)", "destination": "/blog.html?post=$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/history", "destination": "/history.html" },
    { "source": "/sec-recovery-9428", "destination": "/sec-recovery-9428.html" },
    { "source": "/system-override-4286", "destination": "/sec-recovery-9428.html" }
  ]
}
