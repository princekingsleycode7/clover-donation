{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/admin/status", "destination": "/api/admin-status" },
    { "source": "/api/admin/login", "destination": "/api/admin-login" },
    { "source": "/api/admin/register", "destination": "/api/admin-register" },
    { "source": "/api/admin-actions", "destination": "/api/admin-actions" },
    { "source": "/api/ledger/donations", "destination": "/api/ledger-donations" },
    { "source": "/api/ledger/unlock", "destination": "/api/ledger-unlock" },
    { "source": "/api/analytics/track", "destination": "/api/analytics-track" },
    { "source": "/api/analytics/summary", "destination": "/api/analytics-summary" },
    { "source": "/initiate-donation", "destination": "/api/initiate-donation" },
    { "source": "/config", "destination": "/api/config" },
    { "source": "/verify-transaction", "destination": "/api/verify-transaction" },
    { "source": "/donation-total", "destination": "/api/donation-total" },
    { "source": "/version1", "destination": "/version1.html" },
    { "source": "/v1", "destination": "/version1.html" },
    { "source": "/version2", "destination": "/version2.html" },
    { "source": "/v2", "destination": "/version2.html" },
    { "source": "/amira", "destination": "/amira.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/(.*)", "destination": "/blog.html?post=$1" },
    { "source": "/stories", "destination": "/blog.html" },
    { "source": "/stories/(.*)", "destination": "/blog.html?post=$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/history", "destination": "/history.html" }
  ]
}
