{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/transactions/(.*)", "destination": "/api/index.ts" },
    { "source": "/verify-transaction", "destination": "/api/index.ts" },
    { "source": "/donation-total", "destination": "/api/index.ts" },
    { "source": "/version1", "destination": "/version1.html" },
    { "source": "/v1", "destination": "/version1.html" },
    { "source": "/version2", "destination": "/version2.html" },
    { "source": "/v2", "destination": "/version2.html" },
    { "source": "/amira", "destination": "/amira.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/history", "destination": "/history.html" }
  ]
}
