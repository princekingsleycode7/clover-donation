# SUPABASE EDGE FUNCTION SECRETS (Set via `supabase secrets set ...`)
# PAYSTACK_SECRET_KEY: Used strictly server-side in Edge Functions for signature verification,
# plan provisioning, and transaction reconciliation. NEVER expose to the browser!
PAYSTACK_SECRET_KEY="sk_live_your_secret_key_here"

# RESEND_API_KEY: Used in paystack-webhook, donor-history, and recurring-reminder Edge Functions
# to send receipts, milestone alerts, and one-time magic links.
RESEND_API_KEY="re_your_resend_api_key_here"

# SUPABASE_URL: URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: High-privilege key for Edge Functions to bypass RLS for admin operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# CLIENT-SAFE VARIABLES (Can be exposed to the browser)
# PAYSTACK_PUBLIC_KEY: Used in client-side Paystack Inline JS
PAYSTACK_PUBLIC_KEY="pk_live_your_public_key_here"

# SUPABASE_ANON_KEY: Public key for client-side queries on public views
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# APP_URL: The public origin URL of the hosted application
APP_URL="https://ais-dev-nm2a5gjkuu3egwuujnnkry-104892317049.europe-west2.run.app"

